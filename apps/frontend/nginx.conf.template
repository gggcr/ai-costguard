server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;

    # Resolve the core on every request: it gets a new address when it restarts (Docker, Kubernetes)
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $core ${CORE_URL};

    # Security headers of every answer (security-headers.conf). nginx drops server-level add_header in a location
    # that has its own add_header, so the locations below include the file again.
    include /etc/nginx/security-headers.conf;

    # The live notification stream: no buffering, long reads
    location = /api/v1/notifications/stream {
        proxy_pass $core;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass $core;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50m;
    }

    # SCIM 2.0 for identity providers (ADR 0043): the core checks the SCIM token itself
    location /scim/v2/ {
        proxy_pass $core;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 1m;
    }

    # Hashed bundles never change; index.html always revalidates
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security-headers.conf;
    }

    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
