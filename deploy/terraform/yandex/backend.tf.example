# Copy to backend.tf. The bucket and the access key are created once by hand (see docs/runbooks/terraform.md).
terraform {
  backend "s3" {
    endpoints                   = { s3 = "https://storage.yandexcloud.net" }
    bucket                      = "costguard-terraform-state"
    key                         = "yandex/terraform.tfstate"
    # A backend cannot read variables: keep this equal to var.region (ADR 0024).
    region                      = "ru-central1"
    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
  }
}
