{
  "realm": "costguard",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Company owner"
      },
      {
        "name": "finance",
        "description": "Finance"
      },
      {
        "name": "it_admin",
        "description": "IT administrator"
      },
      {
        "name": "agent_owner",
        "description": "Agent owner"
      },
      {
        "name": "auditor",
        "description": "Read-only, verifies receipts"
      },
      {
        "name": "employee",
        "description": "Employee: only their own cabinet, no company data (ADR 0051)"
      },
      {
        "name": "connector",
        "description": "Service account of a company's connector agent: reads the secrets kept in the core (ADR 0030)"
      },
      {
        "name": "forecast",
        "description": "Service account of a company's forecast job: publishes forecasts to the core (ADR 0034)"
      },
      {
        "name": "importer",
        "description": "Service account of a company's job that brings FOCUS exports from its bucket (ADR 0046)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "costguard-frontend",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "costguard-e2e",
      "publicClient": true,
      "standardFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "name": "E2E tests and scripts (local stack only)",
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "costguard-privacy",
      "name": "Core: deletes accounts when a person or a company is erased (ADR 0021)",
      "description": "Local stack only. Staging and prod create this client in their own Keycloak with a secret from Vault (docs/runbooks/privacy.md).",
      "publicClient": false,
      "secret": "costguard-privacy-local",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "costguard-registration",
      "name": "Core: creates accounts of self-registered companies and invited people (ADR 0036)",
      "description": "Local stack only. Staging and prod create this client in their own Keycloak with a secret from Vault (docs/runbooks/registration.md).",
      "publicClient": false,
      "secret": "costguard-registration-local",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-costguard-privacy",
      "enabled": true,
      "serviceAccountClientId": "costguard-privacy",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "service-account-costguard-registration",
      "enabled": true,
      "serviceAccountClientId": "costguard-registration",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "query-users",
          "manage-users",
          "view-realm",
          "view-identity-providers",
          "manage-identity-providers"
        ]
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant ID\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false,\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$\",\"error-message\":\"tenant_id must be a UUID\"}}}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@costguard.local",
    "fromDisplayName": "CostGuard"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpSupportedApplications": [
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName",
    "totpAppFreeOTPName"
  ],
  "authenticationFlows": [
    {
      "alias": "costguard browser",
      "description": "Password or the company's Microsoft 365, then always a one-time code (ADR 0058)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "costguard browser forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "costguard browser forms",
      "description": "Password and a code of an authenticator app, set up on the first login",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": true
        }
      ]
    },
    {
      "alias": "costguard post broker",
      "description": "After Microsoft 365: a code of an authenticator app, set up on the first login",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-otp-form",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": true
        }
      ]
    },
    {
      "alias": "costguard first broker login",
      "description": "Only people who already have an account; it is linked once its owner confirms by e-mail or password",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-detect-existing-broker-user",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "flowAlias": "costguard confirm account",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "costguard confirm account",
      "description": "A link to the account's e-mail or its password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-email-verification",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-username-password-form",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "browserFlow": "costguard browser"
}
