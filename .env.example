DB_URL=jdbc:postgresql://localhost:5432/costguard
DB_USER=costguard
DB_PASSWORD=costguard
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8085
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/costguard
KEYCLOAK_ADMIN_PASSWORD=admin
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=costguard
CLICKHOUSE_PASSWORD=costguard
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=costguard
S3_SECRET_KEY=costguard-secret
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root
VAULT_ENABLED=false

# Core: an approved operation of at least this many roubles is confirmed in NEAR (ADR 0009).
COSTGUARD_NOTARY_CONFIRM_ABOVE=100000

# Core: retention and erasure of personal data (ADR 0021, docs/privacy/data-inventory.md). Erasures delete
# Keycloak accounts as the confidential client costguard-privacy; empty secret = a person deletes them by hand.
KEYCLOAK_ADMIN_URL=http://localhost:8180
KEYCLOAK_PRIVACY_CLIENT_SECRET=costguard-privacy-local
PRIVACY_RETENTION_ENABLED=true
# PRIVACY_RETAIN_DISMISSED_EMPLOYEES=P1Y
# PRIVACY_RETAIN_ACTIVITY=P1Y
# PRIVACY_RETAIN_NOTIFICATIONS=P1Y
# PRIVACY_RETAIN_HANDOVER_ACTS=P5Y
# PRIVACY_RETAIN_IMPORT_FILES=P5Y
# PRIVACY_RETAIN_ACTION_LOG=P3Y
# PRIVACY_COMPANY_GRACE=P30D

# NEAR notary (apps/python/notary). The account and its key come from near-cli; never commit a real key.
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_CONTRACT_ID=
NOTARY_REQUESTS_GROUP_ID=notary-requests

# Gateway: keys of paid APIs behind /v1/egress/<name>/ (ADR 0010), one per configured API, for example:
# SPARK_API_KEY=

# Gateway: the AI assessor of step 6 (ADR 0011). Off while either is empty; the provider is a key of
# costguard.gateway.providers (openai, anthropic, gigachat, yandex) and uses that provider's key above.
ASSESSOR_PROVIDER=
ASSESSOR_MODEL=
ASSESSOR_TIMEOUT=PT3S

# Ingest: OCR of scans and photos with Tesseract (ADR 0012). On by default; the program must be installed.
INGEST_OCR_ENABLED=true
INGEST_TESSERACT=tesseract
INGEST_OCR_LANGUAGES=rus+eng

# Ingest: invoice extraction from text through the CostGuard gateway (ADR 0013). Off until the key and the model
# are set. The key is a virtual key of CostGuard's own agent, never a provider key.
INGEST_LLM_GATEWAY_URL=http://localhost:8081
INGEST_LLM_API_KEY=
INGEST_LLM_PROVIDER=openai
INGEST_LLM_MODEL=
INGEST_LLM_FOLDER_ID=
INGEST_LLM_CONFIDENCE=0.9
INGEST_LLM_TIMEOUT_SECONDS=120

# Ingest: payments through intermediaries in bank statements (ADR 0015): INNs or names of agents, and extra
# services to look for in purposes as "alias=Vendor;alias=Vendor".
INGEST_PAYMENT_INTERMEDIARIES=
INGEST_PAYMENT_SERVICES=

# Connector agent (apps/python/connectors/agent.py): secrets of the new connectors. Under Airflow each one is
# prefixed with the tenant name: ROMASHKA_OKTA_TOKEN.
GOOGLE_WORKSPACE_KEY=
OKTA_TOKEN=
ENTRA_CLIENT_SECRET=
MERGE_API_KEY=
MERGE_ACCOUNTING_TOKEN=
MERGE_HRIS_TOKEN=
TBANK_TOKEN=

# Anomaly detector: the risk of agents (ADR 0016). Models are kept in MLflow; without it the rules work alone.
MLFLOW_TRACKING_URI=http://localhost:5000
ANOMALY_TIME_ZONE=Europe/Moscow
ANOMALY_MODELS_SAVE_EVERY=5000

# Core: secrets of connected systems kept in the core, encrypted (ADR 0030). openssl rand -base64 32, keep it forever.
# Empty: secrets stay in the connector agent's environment only.
CONNECTIONS_ENCRYPTION_KEY=
# Connector agent: takes secrets kept in the core with a token of the company's service account (role connector).
CORE_URL=http://localhost:8080
CORE_TOKEN=

# Core: «Синхронизировать сейчас» starts the Airflow DAG costguard_connector_sync through the REST API (ADR 0019).
# Empty AIRFLOW_URL: the agent pulls the system on its next hourly round instead.
AIRFLOW_URL=
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=

# Notifications to people (ADR 0031). Locally e-mail goes to Mailpit (http://localhost:8025) without settings.
# A Telegram bot from @BotFather: put its token here, then «Уведомления» → «Подключить Telegram» in the web client.
TELEGRAM_BOT_TOKEN=

# Self-registration and invitations (ADR 0032). Accounts are created as the confidential client costguard-registration;
# empty secret: registration and invitations answer 503. Keycloak sends the e-mails with its own SMTP settings.
KEYCLOAK_REGISTRATION_CLIENT_SECRET=costguard-registration-local
REGISTRATION_LINK_LIFESPAN=PT24H
REGISTRATION_UNCONFIRMED_FOR=PT48H
REGISTRATION_LIMIT_PER_IP=5
REGISTRATION_LIMIT_PER_EMAIL=3
REGISTRATION_LIMIT_WINDOW=PT1H
# The client address behind the ingress comes from X-Forwarded-For (native: trusted from internal proxies only).
FORWARD_HEADERS_STRATEGY=native

# Pricing plans (ADR 0033). Limits and prices are in application.yaml (costguard.plans.catalog) and can be overridden
# by relaxed names, e.g. COSTGUARD_PLANS_CATALOG_START_LIMITS_AGENTS=20.
PLAN_TRIAL_LENGTH=P14D
PLAN_WARN_BEFORE=P3D
# Payment provider (ADR 0034). Empty: no payments. dummy: every payment succeeds without money, local stack only.
PAYMENT_PROVIDER=dummy
